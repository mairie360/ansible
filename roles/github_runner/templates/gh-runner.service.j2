# GENERATED BY ANSIBLE (role github_runner) — do not edit on the machine.
# Ephemeral GitHub Actions runner of {{ github_runner_repo }}, labels
# {{ github_runner_labels | join(', ') }} (MAIR-346).
# One job per service start: prepare.sh (root) registers a just-in-time
# runner, start.sh (runner user) runs one job and exits, systemd restarts.
[Unit]
Description=GitHub Actions ephemeral runner for {{ github_runner_repo }}
Wants=network-online.target
After=network-online.target
# Keep retrying when GitHub is unreachable instead of giving up.
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ github_runner_user }}
Group={{ github_runner_user }}
EnvironmentFile=/etc/gh-runner/runner.env
Environment=HOME=/var/lib/gh-runner/home
RuntimeDirectory=gh-runner
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/local/lib/gh-runner/prepare.sh
ExecStart=/usr/local/lib/gh-runner/start.sh
Restart=always
RestartSec=10
# Stop the whole unit cgroup: no process of a finished job survives it.
KillMode=control-group
TimeoutStopSec=300

# --- Sandbox of the runner and its jobs (not of the `+` pre-start step) ---
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gh-runner
ProtectHome=read-only
InaccessiblePaths=-/root -/etc/gh-runner
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# --- Network: outbound to GitHub and the Internet only --------------------
# No route to the group's tunnel ({{ wg_subnet }}) except the instances it
# verifies, nor to this machine's own pod and Service networks (Argo CD).
# Nothing here opens a port: the runner only makes outbound HTTPS to GitHub.
IPAddressDeny={{ wg_subnet }} {{ k3s_cluster_cidr }} {{ k3s_service_cidr }}
{% if github_runner_allowed_ips | length > 0 %}
IPAddressAllow={{ github_runner_allowed_ips | join(' ') }}
{% endif %}

[Install]
WantedBy=multi-user.target
