# GENERATED BY ANSIBLE (role ops_runner) — do not edit on the machine.
# Ephemeral GitHub Actions runner of {{ ops_runner_repo }}, labels
# {{ ops_runner_labels | join(', ') }} (MAIR-803).
# Same scripts and cycle as gh-runner.service (MAIR-346): prepare.sh (root)
# registers a just-in-time runner, start.sh runs one job and exits.
[Unit]
Description=GitHub Actions ephemeral operations runner for {{ ops_runner_repo }}
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ ops_runner_user }}
Group={{ ops_runner_user }}
EnvironmentFile=/etc/gh-ops/runner.env
Environment=HOME=/var/lib/gh-ops/state/home
RuntimeDirectory=gh-ops
RuntimeDirectoryMode=0700
ExecStartPre=+/usr/local/lib/gh-ops/prepare.sh
ExecStart=/usr/local/lib/gh-ops/start.sh
Restart=always
RestartSec=10
# Stop the whole unit cgroup: no process of a finished job survives it, nor
# an operation the job started through sudo.
KillMode=control-group
TimeoutStopSec=600

# --- Sandbox -------------------------------------------------------------
# Lighter than gh-runner.service: the wrapper the job starts through sudo
# runs Ansible as root inside this unit, and must write /root/.ansible,
# /opt/Deploiment and /var/lib/mairie360-ops. NoNewPrivileges would forbid
# sudo itself. What stays is what does not get in the wrapper's way.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
InaccessiblePaths=-/etc/gh-runner -/home/gh-runner
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

# --- Network -------------------------------------------------------------
# No route to the group's tunnel ({{ wg_subnet }}) except the instances the
# operations run on (kubectl and SSH over WireGuard), nor to this machine's
# pod and Service networks. Argo CD's own API server is reached on loopback.
IPAddressDeny={{ wg_subnet }} {{ k3s_cluster_cidr }} {{ k3s_service_cidr }}
{% if ops_runner_targets | length > 0 %}
IPAddressAllow={{ ops_runner_targets | map(attribute='wg_ip') | join(' ') }}
{% endif %}

[Install]
WantedBy=multi-user.target
