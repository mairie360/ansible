# Generated by ansible role hub_probe: external probe of {{ org_id }}
# and scrape of its Argo CD.
# The token is in Secret hub-probe-token, created apart (never in this file).
{% set collector_config %}
receivers:
  httpcheck:
    collection_interval: {{ hub_probe_interval }}
    targets:
{% for url in hub_probe_urls %}
      - endpoint: {{ url | to_json }}
        method: GET
{% endfor %}
{% if hub_probe_argocd_metrics_target | length > 0 %}
  # Argo CD of the group.
  prometheus/argocd:
    config:
      scrape_configs:
        - job_name: argocd
          scrape_interval: {{ hub_probe_argocd_scrape_interval }}
          static_configs:
            - targets: [{{ hub_probe_argocd_metrics_target | to_json }}]
          metric_relabel_configs:
            - source_labels: [__name__]
              regex: {{ hub_probe_argocd_keep_metrics | replace('$', '$$') | to_json }}
              action: keep
{% endif %}
processors:
  batch: {}
  resource:
    attributes:
      - { key: mairie360.org, value: {{ org_id | to_json }}, action: upsert }
exporters:
  otlphttp/cockpit:
    metrics_endpoint: {{ hub_probe_metrics_endpoint | to_json }}
    timeout: {{ hub_probe_timeout }}
    headers:
      X-TOKEN: "${env:COCKPIT_TOKEN}"
extensions:
  health_check:
    endpoint: 0.0.0.0:13133
service:
  extensions: [health_check]
  pipelines:
    metrics:
      receivers: [httpcheck{{ ', prometheus/argocd' if hub_probe_argocd_metrics_target | length > 0 else '' }}]
      processors: [resource, batch]
      exporters: [otlphttp/cockpit]
{% endset %}
apiVersion: v1
kind: ConfigMap
metadata:
  name: hub-probe
  namespace: {{ hub_probe_namespace }}
data:
  config.yaml: |
{{ collector_config | indent(4, true) }}
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: hub-probe
  namespace: {{ hub_probe_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels: { app: hub-probe }
  template:
    metadata:
      labels: { app: hub-probe }
      annotations:
        # Restart on a change of the whole collector configuration (the Collector
        # does not watch its file) and when the token Secret is updated (a Secret
        # read through an environment variable is not refreshed in a running pod).
        mairie360.fr/config: {{ collector_config | hash('sha256') }}
        mairie360.fr/token-revision: {{ hub_probe_secret_revision | to_json }}
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        seccompProfile: { type: RuntimeDefault }
      containers:
        - name: otel-collector
          image: {{ hub_probe_image }}:{{ hub_probe_image_tag }}
          args: ["--config=/conf/config.yaml"]
          env:
            - name: COCKPIT_TOKEN
              valueFrom:
                secretKeyRef: { name: hub-probe-token, key: COCKPIT_TOKEN }
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities: { drop: [ALL] }
          resources:
            requests: { cpu: 10m, memory: 48Mi }
            limits: { cpu: 200m, memory: 128Mi }
          livenessProbe:
            httpGet: { path: /, port: 13133 }
          volumeMounts:
            - { name: conf, mountPath: /conf, readOnly: true }
      volumes:
        - name: conf
          configMap: { name: hub-probe }
