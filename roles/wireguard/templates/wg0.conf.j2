# GENERATED BY ANSIBLE (role wireguard) — do not edit by hand.
#
# Group: {{ org_id }}
# Role : {% if inventory_hostname in groups[org_group ~ '_argocd'] %}server (Argo CD){% else %}client (instance){% endif %}


[Interface]
Address = {{ wg_ip }}/24
PrivateKey = {{ wg_private_key }}
{% if inventory_hostname in groups[org_group ~ '_argocd'] %}
ListenPort = {{ wg_port }}
{% endif %}

{% if inventory_hostname in groups[org_group ~ '_argocd'] %}
{# Server: one peer per instance OF THE SAME GROUP, plus the admin peers. #}
{% for host in groups[org_group ~ '_instances'] | default([]) %}
# {{ host }}
[Peer]
PublicKey = {{ hostvars[host].wg_public_key }}
AllowedIPs = {{ hostvars[host].wg_ip }}/32

{% endfor %}
{% for admin in wireguard_admin_peers %}
# admin: {{ admin.name }}
[Peer]
PublicKey = {{ admin.public_key }}
AllowedIPs = {{ admin.wg_ip }}/32

{% endfor %}
{% else %}
{# Instance: a single peer, its group's Argo CD, which also routes the admin
   peers to it (SSH only, see the role tasks). #}
{% set argocd_host = groups[org_group ~ '_argocd'][0] %}
# {{ argocd_host }}
[Peer]
PublicKey = {{ hostvars[argocd_host].wg_public_key }}
Endpoint = {{ hostvars[argocd_host].public_ip }}:{{ wg_port }}
AllowedIPs = {{ ([hostvars[argocd_host].wg_ip] + wireguard_admin_peers | map(attribute='wg_ip') | list) | map('regex_replace', '$', '/32') | join(', ') }}
PersistentKeepalive = 25
{% endif %}
