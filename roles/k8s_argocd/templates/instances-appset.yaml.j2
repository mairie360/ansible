# GENERATED BY ANSIBLE (role k8s_argocd) — do not edit on the machine.
# Source: roles/k8s_argocd/templates/instances-appset.yaml.j2
#
# ApplicationSet SCOPED TO GROUP "{{ org_id }}".
#
# It only scans clusters/{{ org_id }}/instances/*: this Argo CD never sees
# another client's instances. That is why environment names need no prefix —
# a client "prod" does not collide with the mairie360 "prod", since both live
# in different Argo CDs.
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: instances
  namespace: argocd
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]

  # argocd-image-updater writes each image's new tag into
  # spec.source.helm.parameters. Without this exception, the ApplicationSet
  # controller would reset the list on its next reconciliation.
  ignoreApplicationDifferences:
    - jsonPointers:
        - /spec/source/helm/parameters

  generators:
    - git:
        repoURL: {{ deploiment_repo_url }}
        revision: {{ deploiment_repo_branch }}
        directories:
          - path: "clusters/{{ org_id }}/instances/*"

  template:
    metadata:
      name: '{% raw %}{{ .path.basename }}{% endraw %}'
    spec:
      # MAIR-414: Deploiment's bootstrap/appsets/projects.yaml (this repo
      # only, mairie360-* namespaces, no cluster-scoped kind but Namespace
      # and the collector's ClusterRole/Binding). It must exist before this
      # AppSet is applied: Deploiment main first, then this role.
      project: mairie360-instances
      # SINGLE source on purpose: chart and values come from the same repo at
      # the same revision. The previous multi-source layout (chart + a `ref:`
      # source feeding $values, both on {{ deploiment_repo_branch }}) resolved
      # the branch twice; a push landing in between made the repo-server
      # reject the generation ("cannot reference a different revision of the
      # same repository") and the sync operation stayed pinned on the old SHA
      # until `argocd app terminate-op` (MAIR-173, upstream
      # argoproj/argo-cd#29716, still present in 3.5). With one source there
      # is one revision to resolve, so a push mid-sync is simply picked up by
      # the next auto-sync.
      #
      # Value files are read through a path relative to the chart directory.
      # Argo CD accepts it without any repo-server flag as long as it stays
      # inside the repository root.
      #
      # The revision depends on the environment (deploiment_env_revisions):
      # dev follows {{ deploiment_repo_branch }}, staging and prod follow the
      # branches the "Promote" workflow of Deploiment advances. The git
      # generator above still lists directories on {{ deploiment_repo_branch }}
      # only, so a new environment directory must be promoted before its
      # Application can render.
      source:
        repoURL: {{ deploiment_repo_url }}
        targetRevision: '{% raw %}{{ index (dict{% endraw %}{% for env, rev in deploiment_env_revisions.items() %} {{ env | to_json }} {{ rev | to_json }}{% endfor %}{% raw %}) .path.basename | default {% endraw %}{{ deploiment_repo_branch | to_json }}{% raw %} }}{% endraw %}'
        path: charts/mairie360-stack
        helm:
          # releaseName = environment name: resources are prefixed
          # dev- / staging- / prod-.
          releaseName: '{% raw %}{{ .path.basename }}{% endraw %}'
          valueFiles:
            # Shared by every instance of this environment, whatever its
            # group (MAIR-414): clusters/_base/prod.yaml holds the versions
            # and settings of every prod. Missing for dev/staging.
            - '../../clusters/_base/{% raw %}{{ .path.basename }}{% endraw %}.yaml'
            - '../../{% raw %}{{ .path.path }}{% endraw %}/values.yaml'
            # Instance SealedSecret, produced by scripts/seal-secrets.sh.
            # Missing until it is generated: ignoreMissingValueFiles keeps
            # the sync working meanwhile.
            - '../../{% raw %}{{ .path.path }}{% endraw %}/secrets.yaml'
          ignoreMissingValueFiles: true
      destination:
        # Name under which role k8s_instance_link registers the cluster.
        name: '{% raw %}{{ .path.basename }}{% endraw %}'
        namespace: 'mairie360-{% raw %}{{ .path.basename }}{% endraw %}'
      # The API server adds fields to every volumeClaimTemplates entry of a
      # StatefulSet (apiVersion, kind, status, spec.volumeMode) that the chart
      # does not declare. Argo CD reports them as a difference forever, so an
      # instance stayed OutOfSync although the sync succeeded and the live
      # objects matched the chart. Ignore only those defaulted fields: the
      # rest of the template (size, storage class, access modes) is still
      # compared.
      ignoreDifferences:
        - group: apps
          kind: StatefulSet
          jqPathExpressions:
            - '.spec.volumeClaimTemplates[]?.apiVersion'
            - '.spec.volumeClaimTemplates[]?.kind'
            - '.spec.volumeClaimTemplates[]?.status'
            - '.spec.volumeClaimTemplates[]?.spec.volumeMode'

  # syncPolicy is an object field, so it cannot be templated in place: only
  # the environments of deploiment_auto_sync_envs ({{ deploiment_auto_sync_envs | join(', ') }}) get automated
  # sync; the others are synced by hand from Argo CD (the Application shows
  # OutOfSync until then). syncOptions apply to every environment.
  templatePatch: |
    spec:
      syncPolicy:
        {%- raw %}
        {{- if has .path.basename (list{% endraw %}{% for env in deploiment_auto_sync_envs %} {{ env | to_json }}{% endfor %}{% raw %}) }}
        automated:
          prune: true
          selfHeal: true
        {{- end }}{% endraw %}

        syncOptions:
          - CreateNamespace=true
          - ServerSideApply=true
