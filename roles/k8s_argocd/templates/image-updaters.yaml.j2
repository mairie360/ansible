#
# One ImageUpdater per instance of group "{{ org_id }}". argocd-image-updater
# v1 is configured by these custom resources, not by Application annotations.
# Each one targets the Application the instances ApplicationSet names after
# the environment, and writes the new tags into its Helm parameters
# (write-back `argocd`, no git commit). The ApplicationSet ignores that field
# (ignoreApplicationDifferences), so the next sync does not revert them.
#
# Registry credentials come from the chart config of
# Deploiment/bootstrap/appsets/image-updater-app.yaml (pullsecret:argocd/ghcr-secret).
{% for host in groups[org_group ~ '_instances'] | default([]) %}
{% set env = hostvars[host].env_name %}
{% set policy = image_updater_policies[env] | default(image_updater_policies['default']) %}
---
apiVersion: argocd-image-updater.argoproj.io/v1alpha1
kind: ImageUpdater
metadata:
  name: {{ env }}
  namespace: argocd
spec:
  commonUpdateSettings:
    updateStrategy: {{ policy.strategy | to_json }}
    allowTags: {{ policy.allow_tags | to_json }}
  writeBackConfig:
    method: argocd
  applicationRefs:
    - namePattern: {{ env | to_json }}
      images:
{% for svc in image_updater_services %}
        - alias: {{ svc.alias }}
          imageName: {{ svc.image }}
          manifestTargets:
            helm:
              name: {{ svc.path }}.image.repository
              tag: {{ svc.path }}.image.tag
{% endfor %}
{% endfor %}
