apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: argocd-server-ingress
  namespace: argocd
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: websecure
    traefik.ingress.kubernetes.io/router.tls: "true"
    cert-manager.io/cluster-issuer: "letsencrypt-prod" # <--- LIGNE À AJOUTER
spec:
  tls: # <--- TOUT CE BLOC TLS EST À AJOUTER
  - hosts:
    - "{{ argocd_domain }}"
    secretName: argocd-server-tls
  rules:
  - host: "{{ argocd_domain }}"
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: argocd-server
            port:
              number: 80